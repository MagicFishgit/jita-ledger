# Copy to .env.local for local development.
# Client ID from https://developers.eveonline.com (it's public, not a secret).
VITE_EVE_CLIENT_ID=your-client-id-here

# Optional: only set this if the browser blocks the SSO token request (see README, "If login fails").
# VITE_TOKEN_PROXY=https://your-worker.your-subdomain.workers.dev
