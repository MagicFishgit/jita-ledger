{
  "name": "jita-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p worker && vite build",
    "preview": "vite preview",
    "check": "node --import ./scripts/register.mjs scripts/check.mjs",
    "scan-live": "node --import ./scripts/register.mjs scripts/scan-live.mjs",
    "worker:deploy": "cd worker && wrangler deploy",
    "worker:dev": "cd worker && wrangler dev --port 8787 --var DEV_AUTH_CHAR:90000001"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wrangler": "^4.142.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
